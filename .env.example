LLM_PROVIDER=nvidia_nim
NVIDIA_API_KEY=replace-with-your-NVIDIA-NIM-key
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/nemotron-3-nano-30b-a3b
NVIDIA_NIM_FALLBACK_MODEL=Nemotron 3.5 Lightning
NVIDIA_NIM_TIMEOUT=60

# Optional, for deterministic mode (no API key needed):
# LLM_PROVIDER=deterministic

# Optional alternate providers:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=replace-with-your-Anthropic-key
# ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# Optional, defaults to checkin_buddy.db in this project folder:
# DATABASE_URL=sqlite:///C:/path/to/checkin_buddy.db
